# API keys (only set the provider you want to use; the other can stay blank)
SCORER_PROVIDER=azure       # azure | anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Azure OpenAI (Microsoft)
AZURE_OPENAI_ENDPOINT=        # e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=      # the deployment name you created in Azure
AZURE_OPENAI_API_VERSION=2024-10-21

# Jira API (Atlassian Cloud) — required for refresh endpoints to pull live data
# from Jira. Leave blank for offline / seed-only mode. See JIRA-HANDOFF.md.
JIRA_BASE_URL=               # e.g. https://ashley-furniture-team.atlassian.net
JIRA_EMAIL=                  # service-account email
JIRA_API_TOKEN=              # generated at https://id.atlassian.com/manage-profile/security/api-tokens

# Microsoft Entra ID (Azure AD) SSO — optional. Leave AUTH_PROVIDER blank
# (or omit) to run in single-user / actor-name mode. When enabled, every
# /api request requires a logged-in user and decisions are attributed to
# the user's Entra email rather than the actor textbox. See AUTH-HANDOFF.md.
AUTH_PROVIDER=                  # set to "microsoft" to enable
AZURE_AD_TENANT_ID=             # GUID, verified domain, or "common"
AZURE_AD_CLIENT_ID=             # App registration's Application (client) ID
AZURE_AD_CLIENT_SECRET=         # Client secret from the app registration
AUTH_REDIRECT_URI=http://localhost:4173/auth/callback
AUTH_SESSION_SECRET=            # long random string for signing session cookies

# Server
PORT=4173
